# Anthropic Configuration (preferred provider — used automatically when set)
# Add your Anthropic API key here for server-side orchestrations
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI Configuration (used only if ANTHROPIC_API_KEY is not set)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.0

# CRM MCP Server URL Configuration (using the stateless Streamable HTTP url)
CRM_MCP_SERVER_URL=https://headlessmcp.vercel.app/mcp
